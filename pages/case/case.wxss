.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #f5f7fa;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.section-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.input-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.case-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.input-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.filter-area {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-tag {
  padding: 12rpx 24rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-tag.selected {
  background: #1E88E5;
  color: #fff;
}

.quick-cases {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f0f7ff;
  border-radius: 30rpx;
  gap: 10rpx;
}

.quick-icon {
  font-size: 28rpx;
}

.quick-text {
  font-size: 26rpx;
  color: #1E88E5;
}

.action-btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  gap: 12rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.searching-section {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.searching-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.searching-animation {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.searching-ring {
  width: 100%;
  height: 100%;
  border: 8rpx solid #e3f2fd;
  border-top-color: #1E88E5;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.searching-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.searching-step {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.searching-hint {
  font-size: 24rpx;
  color: #999;
}

.result-section {
  padding: 0;
}

.result-header {
  margin-bottom: 20rpx;
}

.result-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-count {
  font-size: 28rpx;
  color: #666;
}

.result-count .highlight {
  color: #1E88E5;
  font-weight: bold;
}

.result-filter {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  gap: 8rpx;
}

.filter-arrow {
  font-size: 20rpx;
}

.case-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.case-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.case-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.case-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.case-court,
.case-date {
  font-size: 24rpx;
  color: #999;
}

.case-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.case-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.similarity {
  font-size: 24rpx;
  color: #1E88E5;
  font-weight: 500;
}

.case-result {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.case-result.win {
  background: #f6ffed;
  color: #52c41a;
}

.case-result.lose {
  background: #fff1f0;
  color: #ff4d4f;
}

.case-result.partial {
  background: #fffbe6;
  color: #faad14;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-section {
  padding: 0;
}

.detail-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
}

.detail-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-right: 60rpx;
}

.case-detail {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.detail-title-section {
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.detail-case-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.detail-case-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.info-divider {
  margin: 0 16rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.law-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.law-item {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.law-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1E88E5;
  margin-bottom: 8rpx;
}

.law-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}