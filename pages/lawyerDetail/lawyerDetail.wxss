.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 140rpx;
}

.header {
  position: relative;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
}

.lawyer-profile {
  position: relative;
  display: flex;
  align-items: center;
  padding: 80rpx 30rpx 0;
  gap: 24rpx;
}

.lawyer-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #f0f0f0;
}

.lawyer-basic {
  flex: 1;
  color: #fff;
}

.lawyer-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.lawyer-title {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 6rpx;
}

.lawyer-firm {
  font-size: 24rpx;
  opacity: 0.8;
}

.stats-section {
  background: #fff;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.info-section {
  background: #fff;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #1E88E5;
}

.specialty-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #e3f2fd;
  color: #1E88E5;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.intro-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.case-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.case-item {
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.case-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.case-result {
  font-size: 24rpx;
  color: #52c41a;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-item {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f7fa;
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reviewer-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.review-date {
  font-size: 22rpx;
  color: #999;
}

.review-rating {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.review-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-label {
  font-size: 24rpx;
  color: #999;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-chat {
  padding: 20rpx 40rpx;
  background: #f5f7fa;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-video {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}