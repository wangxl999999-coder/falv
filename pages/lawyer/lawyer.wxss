.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.filter-section {
  background: #fff;
  padding: 10rpx 0 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
  transition: all 0.3s;
}

.filter-item.active {
  background: #1E88E5;
  color: #fff;
}

.lawyer-list {
  padding: 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lawyer-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.lawyer-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f0f0f0;
}

.lawyer-info {
  flex: 1;
}

.lawyer-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.lawyer-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.lawyer-title {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.lawyer-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #1E88E5;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.lawyer-stats {
  display: flex;
  gap: 40rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f7fa;
  border-bottom: 1rpx solid #f5f7fa;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.lawyer-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-label {
  font-size: 24rpx;
  color: #999;
}

.price-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
}

.consult-btn {
  padding: 16rpx 36rpx;
  background: linear-gradient(135deg, #1E88E5 0%, #1565C0 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}